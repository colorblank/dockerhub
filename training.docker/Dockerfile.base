# syntax=docker/dockerfile:1

# ==================================================================
# training-base —— 公司级 A800 训练基础镜像（第一层）
# CUDA/cuDNN/NCCL + Python + uv + 编译工具。
# 不含 torch，torch 见 Dockerfile.pytorch。
#
# 关键约定：
#   统一 Python 虚拟环境 /opt/venv，后续所有 Python 依赖都装进它，
#   业务镜像不再新建 venv，从而真正复用 base 中预装的 torch。
# ==================================================================
ARG PYTHON_VERSION=3.12
ARG CUDA_VERSION=12.4.1
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu${UBUNTU_VERSION}

ARG PYTHON_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    UV_INSTALL_DIR=/usr/local/bin \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:/root/.cargo/bin:/usr/local/bin:$PATH"

# --- 系统依赖：编译工具 + 常用调试/运维工具 ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config gawk git ca-certificates curl \
    bash-completion htop jq lsof locales netcat-openbsd openssh-client \
    procps strace sudo tmux tree unzip vim wget \
    ripgrep fd-find bat fzf gh git-lfs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- 生成并启用完整 UTF-8 locale（支持中文等非 ASCII 字符）---
RUN locale-gen en_US.UTF-8

# --- uv：唯一的 Python 包管理器 ---
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# --- Node.js 24 LTS（pi coding agent 运行时要求 node >=22.19.0）---
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Rust 工具链（rustup minimal）+ Zellij 终端多路复用器 ---
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && export PATH="/root/.cargo/bin:$PATH" \
    && curl -fsSL https://github.com/zellij-org/zellij/releases/latest/download/zellij-x86_64-unknown-linux-musl.tar.gz \
       | tar -xz -C /usr/local/bin \
    && rustup --version && cargo --version && zellij --version

# --- ble.sh（Bash 命令行编辑器，最新 master）---
RUN git clone --depth 1 --quiet https://github.com/akinomyoga/ble.sh.git /tmp/ble \
    && make -C /tmp/ble install PREFIX=/usr/local >/dev/null \
    && rm -rf /tmp/ble \
    && echo '[[ \$- == *i* ]] && source /usr/local/share/blesh/ble.sh' >> /root/.bashrc

# --- 托管 Python + 建立 /opt/venv ---
RUN uv python install ${PYTHON_VERSION}
RUN uv venv /opt/venv --python ${PYTHON_VERSION}

WORKDIR /app

CMD ["/bin/bash"]