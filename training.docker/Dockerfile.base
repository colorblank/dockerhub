# syntax=docker/dockerfile:1

# ==================================================================
# training-base —— 公司级 A800 训练基础镜像（第一层）
# CUDA/cuDNN/NCCL、Python、CUDA 版 PyTorch 和常用训练依赖。
# torchvision 和 torchaudio 见 Dockerfile.pytorch。
# ==================================================================
ARG PYTHON_VERSION=3.12.16
ARG CUDA_VERSION=12.4.1
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PATH="/root/.cargo/bin:/usr/local/bin:$PATH"

# --- 系统依赖：编译工具 + 常用调试/运维工具 ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config gawk git ca-certificates curl \
    bash-completion htop jq lsof locales netcat-openbsd openssh-client openssh-server \
    procps strace sudo tmux tree unzip vim wget \
    ripgrep fd-find bat fzf gh git-lfs \
    && mkdir -p /var/run/sshd \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- 生成并启用完整 UTF-8 locale（支持中文等非 ASCII 字符）---
RUN locale-gen en_US.UTF-8

# --- Node.js 24 LTS（pi coding agent 运行时要求 node >=22.19.0）---
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Rust 工具链（rustup minimal）+ Zellij 终端多路复用器 ---
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && export PATH="/root/.cargo/bin:$PATH" \
    && curl -fsSL https://github.com/zellij-org/zellij/releases/latest/download/zellij-x86_64-unknown-linux-musl.tar.gz \
       | tar -xz -C /usr/local/bin \
    && rustup --version && cargo --version && zellij --version

# --- ble.sh（Bash 命令行编辑器，最新 master）---
RUN git clone --depth 1 --quiet https://github.com/akinomyoga/ble.sh.git /tmp/ble \
    && make -C /tmp/ble install PREFIX=/usr/local >/dev/null \
    && rm -rf /tmp/ble \
    && echo '[[ $- == *i* ]] && source /usr/local/share/blesh/ble.sh' >> /root/.bashrc

# --- 全局 Python 和 pip，不替换 Ubuntu 的 /usr/bin/python3 ---
ARG PYTHON_VERSION
RUN curl -fsSL "https://github.com/astral-sh/python-build-standalone/releases/download/20261123/cpython-${PYTHON_VERSION}%2B20261123-x86_64-unknown-linux-gnu-install_only.tar.gz" \
    -o /tmp/python.tar.gz \
    && echo '386028a53cceb3be3c1ef8d8828f707d7d3aab67631049f9806e0fb3665a40c8  /tmp/python.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/python.tar.gz --strip-components=1 --no-same-permissions --no-overwrite-dir -C /usr/local \
    && rm /tmp/python.tar.gz

# CUDA 12.4 的官方 PyTorch 发行线止于 2.6.0。
ARG TORCH_VERSION=2.6.0
ARG PYTORCH_INDEX=https://download.pytorch.org/whl/cu124
RUN python -m pip install --no-cache-dir --index-url "${PYTORCH_INDEX}" "torch==${TORCH_VERSION}"

# jupyter 包含 JupyterLab 和 Notebook，DSW 无需在启动时联网安装。
RUN python -m pip install --no-cache-dir \
    jupyter pandas pyarrow pyyaml safetensors \
    && python -c 'import jupyterlab, pandas, pyarrow, safetensors, torch, yaml; assert torch.version.cuda is not None' \
    && jupyter --version

WORKDIR /app

CMD ["/bin/bash"]
