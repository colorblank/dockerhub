# syntax=docker/dockerfile:1

# ==================================================================
# training-pytorch —— 公司级 A800 训练镜像（第二层）
# 继承基础镜像的全局 Python 和 CUDA 版 torch，仅补装视觉和音频扩展。
# 扩展版本必须匹配基础镜像的 torch 2.6.0（cu124）。
# ==================================================================
# 上一层的 base 镜像名由 CI 计算后传入；默认给出一个可用值。
ARG BASE_IMAGE=ghcr.io/colorblank/training-base:cuda12.4.1-ubuntu22.04-py3.12
FROM ${BASE_IMAGE}

ARG TORCHVISION_VERSION=0.21.0
ARG TORCHAUDIO_VERSION=2.6.0
ARG PYTORCH_INDEX=https://download.pytorch.org/whl/cu124

RUN python -m pip install --no-cache-dir --index-url "${PYTORCH_INDEX}" \
    "torchvision==${TORCHVISION_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}"

WORKDIR /app